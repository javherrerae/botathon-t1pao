  <stage stageid="bd292d23-245a-4781-84a8-d48adc7fa4f8" name="Preparar Datos" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="15" y="-60" />
    <onsuccess>b4360efa-b17c-48f7-9a9c-8962643b3bac</onsuccess>
    <steps>
      <calculation expression="[Datos Item.Horas Semanales]" stage="Horas" />
      <calculation expression="Upper(Trim([Datos Item.Cargo]))" stage="Cargo" />
      <calculation expression="Right([Datos Item.Clave], 6)" stage="Periodo Texto" />
      <calculation expression="False" stage="Encontrado" />
      <calculation expression="0" stage="Semanas" />
    </steps>
  </stage>
  <stage stageid="f9bc43a3-7569-4e2a-8d60-c0b616245f2d" name="Loop End1" type="LoopEnd">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
