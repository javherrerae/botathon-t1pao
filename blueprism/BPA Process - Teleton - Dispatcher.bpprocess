  <stage stageid="710e0b55-ae56-408d-a6ee-d03f24b26d5e" name="Item" type="Collection">
    <narrative>el item que se carga a la cola
</narrative>
    <display x="405" y="30" />
    <datatype>collection</datatype>
    <private />
    <alwaysinit />
    <collectioninfo>
      <field name="Clave" type="text" description="clave persona - periodo" />
      <field name="PersonaId" type="number" description="id de la persona" />
      <field name="IT" type="number" />
      <field name="Instituto" type="text" />
      <field name="Cargo" type="text" />
      <field name="Cod_Esp" type="text" description="codigo especialidad?" />
      <field name="Periodo" type="date" description="fecha periodo" />
      <field name="Horas Semanales" type="number" description="cant horas semanales" />
      <field name="Tipo de Contrato" type="text" />
      <field name="Fecha Termino" type="text" />
