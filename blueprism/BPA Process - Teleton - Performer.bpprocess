    <looptype>ForEach</looptype>
    <loopdata>Param Cargos</loopdata>
  </stage>
  <stage stageid="b4a1cd17-f39f-4023-9a15-e83f7b385154" name="¿Es el cargo?" type="Decision">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="15" y="90" />
    <decision expression="Upper(Trim([Param Cargos.Cargo])) = [Cargo]" />
    <ontrue>4b2522a3-89d9-472e-839b-a27b4c474bbb</ontrue>
    <onfalse>f9bc43a3-7569-4e2a-8d60-c0b616245f2d</onfalse>
  </stage>
  <stage stageid="4b2522a3-89d9-472e-839b-a27b4c474bbb" name="Guardar Param" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="-30" y="165" />
    <onsuccess>f9bc43a3-7569-4e2a-8d60-c0b616245f2d</onsuccess>
    <steps>
      <calculation expression="True" stage="Encontrado" />
      <calculation expression="[Param Cargos.Std_Dir_Min]" stage="Std Dir" />
      <calculation expression="[Param Cargos.Std_Ind_Min]" stage="Std Ind" />
      <calculation expression="[Param Cargos.Dir_40mas]" stage="P40 Dir" />
      <calculation expression="[Param Cargos.Ind_40mas]" stage="P40 Ind" />
      <calculation expression="[Param Cargos.Dir_22a40]" stage="P22 Dir" />
      <calculation expression="[Param Cargos.Ind_22a40]" stage="P22 Ind" />
      <calculation expression="[Param Cargos.Dir_menos22]" stage="P0 Dir" />
      <calculation expression="[Param Cargos.Ind_menos22]" stage="P0 Ind" />
    </steps>
  </stage>
  <stage stageid="4b8b3680-bda5-4b9e-a4a7-9e6449c29b7c" name="¿Cargo Encontrado?" type="Decision">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="15" y="225" />
    <decision expression="[Encontrado] = True" />
    <ontrue>b5a90cc8-408e-44c4-95fd-2b4c6736bd27</ontrue>
    <onfalse>6728b5cc-1dd7-4101-ad57-eab75845b763</onfalse>
  </stage>
  <stage stageid="6728b5cc-1dd7-4101-ad57-eab75845b763" name="Exception2" type="Exception">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="135" y="225" />
    <exception localized="yes" type="Business Exception" detail="&quot;Cargo sin parámetros: &quot; &amp; [Cargo]" />
  </stage>
  <stage stageid="1a639214-89d0-4c89-9f74-9fdd02f36caa" name="Otherwise1" type="ChoiceEnd">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="15" y="405" />
    <onsuccess>ac157e2f-5e03-4228-bc00-3f1820cea8e1</onsuccess>
    <groupid>2e724979-fc64-4891-86f9-029aa4a60d10</groupid>
  </stage>
  <stage stageid="b5a90cc8-408e-44c4-95fd-2b4c6736bd27" name="Choice1" type="ChoiceStart">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="15" y="285" />
    <groupid>2e724979-fc64-4891-86f9-029aa4a60d10</groupid>
    <choices>
      <choice expression="[Horas] &gt;= 40">
        <name>40 horas o más</name>
        <distance>30</distance>
        <ontrue>7eecde45-69ed-4e7c-8799-e316c3d66842</ontrue>
      </choice>
      <choice expression="[Horas] &gt;= 22">
        <name>22 a 39 horas</name>
        <distance>75</distance>
        <ontrue>faec0c6d-8af4-483d-a372-c62ea532255c</ontrue>
      </choice>
    </choices>
  </stage>
  <stage stageid="5db10700-ac07-44eb-b830-f3272aa49ca8" name="Loop End2" type="LoopEnd">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
