  <stage stageid="9e8ffa6a-9759-47c0-9539-0f5f3f4d2cb0" name="Armar Resultado" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="180" y="600" />
    <onsuccess>b8cfc343-79f4-4e1e-b3bd-44c3ff228ec9</onsuccess>
    <steps>
      <calculation expression="[Datos Item.Clave]" stage="Resultado.clave" />
      <calculation expression="[Datos Item.PersonaId]" stage="Resultado.personaId" />
      <calculation expression="[Datos Item.IT]" stage="Resultado.it" />
      <calculation expression="[Datos Item.Instituto]" stage="Resultado.instituto" />
      <calculation expression="[Cargo]" stage="Resultado.cargo" />
      <calculation expression="FormatDate([Datos Item.Periodo], &quot;yyyy-MM-dd&quot;)" stage="Resultado.periodo" />
      <calculation expression="[Horas]" stage="Resultado.horasContrato" />
      <calculation expression="[Tramo]" stage="Resultado.tramoJornada" />
      <calculation expression="[Pct Dir]" stage="Resultado.pctDirecto" />
      <calculation expression="[Pct Ind]" stage="Resultado.pctIndirecto" />
      <calculation expression="[Semanas]" stage="Resultado.semanasHabiles" />
      <calculation expression="[Ate Dir]" stage="Resultado.atencionesDirectas" />
      <calculation expression="[Ate Ind]" stage="Resultado.atencionesIndirectas" />
      <calculation expression="[Ate Total]" stage="Resultado.atencionesTotal" />
      <calculation expression="Round([Ate Total] * [Meta Pct], 1)" stage="Resultado.metaGestion" />
      <calculation expression="&quot;COMPLETADO&quot;" stage="Resultado.estado" />
      <calculation expression="&quot;&quot;" stage="Resultado.motivo" />
    </steps>
  </stage>
