# Copiar este archivo como backend/.env y completar. NUNCA subir .env al repositorio.

# Fuente de datos: "postgres" (datos reales del bot) o "mock" (plan B, datos simulados)
FUENTE_DATOS=postgres

# Conexión a PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://cada_hora:CAMBIAR_CLAVE@localhost:5432/cada_hora_cuenta

# Carpeta compartida con la VM donde Blue Prism deja los Resultados_*.xlsx
RESULTADOS_DIR=C:\BotSalida

# (Opcional) Ruta del Excel de parámetros que lee Blue Prism
# PARAMETROS_BOT_PATH=C:\BotSalida\Parametros_Bot.xlsx
