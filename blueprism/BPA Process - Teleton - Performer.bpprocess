  <stage stageid="2d7d30e3-11e1-4cb4-8e60-6ff33e28f853" name="Marcar Completado" type="Action">
    <loginhibit onsuccess="true" />
    <narrative>Marks the item as completed, by updating the Completed timestamp and setting Locked to null. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative>
    <display x="-150" y="210" />
    <inputs>
      <input type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" />
    </inputs>
    <onsuccess>7de5a4b1-9e6e-4703-9b8b-6937034c31e1</onsuccess>
    <resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Completed" />
  </stage>
  <stage stageid="7de5a4b1-9e6e-4703-9b8b-6937034c31e1" name="Sumar Completados" type="Calculation">
    <loginhibit onsuccess="true" />
    <display x="-150" y="105" />
    <onsuccess>f6a75b16-e5b7-4207-bbd0-64df72cf53d7</onsuccess>
    <calculation expression="[Completados] + 1" stage="Completados" />
  </stage>
