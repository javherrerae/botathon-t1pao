  </stage>
  <stage stageid="b5dd202a-5891-442e-93ff-2aedf45316a4" name="Descartados" type="Data">
    <loginhibit onsuccess="true" />
    <narrative>contador para el log</narrative>
    <display x="390" y="120" />
    <datatype>number</datatype>
    <initialvalue>0</initialvalue>
    <private />
    <alwaysinit />
