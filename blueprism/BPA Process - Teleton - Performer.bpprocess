    <looptype>ForEach</looptype>
    <loopdata>Param Semanas</loopdata>
  </stage>
  <stage stageid="d8f41b6a-1507-405c-b3ca-03a46a147e52" name="¿Es el mes?" type="Decision">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="180" y="405" />
    <decision expression="[Param Semanas.Periodo] &amp; &quot;&quot; = [Periodo Texto]" />
    <ontrue>b4928ea6-fb19-472e-9b02-11ac02395cfa</ontrue>
    <onfalse>5db10700-ac07-44eb-b830-f3272aa49ca8</onfalse>
  </stage>
  <stage stageid="b4928ea6-fb19-472e-9b02-11ac02395cfa" name="Semanas Habiles" type="Calculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="210" y="480" />
    <onsuccess>5db10700-ac07-44eb-b830-f3272aa49ca8</onsuccess>
    <calculation expression="[Param Semanas.Semanas_Habiles]" stage="Semanas" />
  </stage>
  <stage stageid="956faa54-c9f6-49ff-8ce1-0c70d552b1d7" name="¿Mes encontrado?" type="Decision">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="105" y="540" />
    <decision expression="[Semanas] &gt; 0" />
    <ontrue>5df8f04b-2121-4fd8-a1ad-6e2eb46e6675</ontrue>
    <onfalse>59cc5c07-f5f8-4c3d-988f-4d8eff4b8c51</onfalse>
  </stage>
  <stage stageid="59cc5c07-f5f8-4c3d-988f-4d8eff4b8c51" name="Exception3" type="Exception">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <display x="180" y="540" />
    <exception localized="yes" type="Business Exception" detail="&quot;Periodo sin semanas hábiles: &quot; &amp; [Periodo Texto]" />
  </stage>
  <stage stageid="5df8f04b-2121-4fd8-a1ad-6e2eb46e6675" name="Calcular Atenciones" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="105" y="600" />
    <onsuccess>9e8ffa6a-9759-47c0-9539-0f5f3f4d2cb0</onsuccess>
    <steps>
      <calculation expression="Round([Horas] * [Pct Dir] * 60 / [Std Dir] * [Semanas], 0)" stage="Ate Dir" />
      <calculation expression="Round([Horas] * [Pct Ind] * 60 / [Std Ind] * [Semanas], 0)" stage="Ate Ind" />
      <calculation expression="[Ate Dir] + [Ate Ind]" stage="Ate Total" />
    </steps>
  </stage>
  <stage stageid="7eecde45-69ed-4e7c-8799-e316c3d66842" name="40 hrs o mas" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="105" y="315" />
    <onsuccess>f67fa984-3001-4dc5-8b81-f0581e93ae44</onsuccess>
    <steps>
      <calculation expression="[P40 Dir]" stage="Pct Dir" />
      <calculation expression="[P40 Ind]" stage="Pct Ind" />
      <calculation expression="&quot;&gt;= 40h&quot;" stage="Tramo" />
    </steps>
  </stage>
  <stage stageid="faec0c6d-8af4-483d-a372-c62ea532255c" name="22 a 39 hrs" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="105" y="360" />
    <onsuccess>f67fa984-3001-4dc5-8b81-f0581e93ae44</onsuccess>
    <steps>
      <calculation expression="[P22 Dir]" stage="Pct Dir" />
      <calculation expression="[P22 Ind]" stage="Pct Ind" />
      <calculation expression="&quot;22-39h&quot;" stage="Tramo" />
    </steps>
  </stage>
  <stage stageid="ac157e2f-5e03-4228-bc00-3f1820cea8e1" name="Otherwise" type="MultipleCalculation">
    <subsheetid>4a7d0bb6-100d-40b0-9a3e-0d358a894566</subsheetid>
    <loginhibit onsuccess="true" />
    <display x="105" y="405" />
    <onsuccess>f67fa984-3001-4dc5-8b81-f0581e93ae44</onsuccess>
    <steps>
      <calculation expression="[P0 Dir]" stage="Pct Dir" />
      <calculation expression="[P0 Ind]" stage="Pct Ind" />
      <calculation expression="&quot;&lt; 22h&quot;" stage="Tramo" />
    </steps>
  </stage>
